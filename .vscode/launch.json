{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug KMS Service",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "-p", "kms-service", "--bin=kms-service"]
      },
      "args": ["serve"],
      "cwd": "${workspaceFolder}/crates/kms-service",
      "envFile": "${workspaceFolder}/crates/kms-service/.env",
      "stopOnEntry": false
    }
  ]
}
