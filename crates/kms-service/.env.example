# ==============================================================================
# Docker Compose & Project Configuration
# ==============================================================================
COMPOSE_PROJECT_NAME=kms_service
APP_ENVIRONMENT=development
DOCKER_RESTART_POLICY=no

# ==============================================================================
# Logging & Observability Configuration
# LOG__LEVEL: trace | debug | info | warn | error
# LOG__FORMAT: json | compact | pretty 
# ==============================================================================
LOG__LEVEL=debug
LOG__FORMAT=json

# ==============================================================================
# KMS Crypto & Envelope Encryption Settings (Multi-Version Master Keys)
# ==============================================================================
CRYPTO__PROVIDER=local
CRYPTO__HSM_SOCKET_PATH=/run/vhsm/vhsm.sock
CRYPTO__CURRENT_MASTER_KEY_VERSION=1
CRYPTO__DEFAULT_KEY_TTL_DAYS=365
CRYPTO__GRACE_PERIOD_MINUTES=30

CRYPTO__MASTER_KEYS__1=KEY_1
CRYPTO__MASTER_KEYS__2=KEY_2
CRYPTO__MASTER_KEYS__3=KEY_3

# HTTP Administrative APIs (default: false for security)
CRYPTO__ENABLE_HTTP_REWRAP=false
CRYPTO__ENABLE_HTTP_LOCK=false

# ==============================================================================
# Dynamiczne sekrety ACL dla usług (zastępują puste wartości w TOML)
# ==============================================================================
ACL__SERVICES__KMS_CLI__SECRET=super-long-random-secret-for-kms-cli-hmac-64-bytes
ACL__SERVICES__GATEWAY_SERVICE__SECRET=super-long-random-secret-for-gateway-service-hmac-64-bytes
ACL__SERVICES__OFFICER_BFF__SECRET=super-long-random-secret-for-officer-bff-hmac-64-bytes
ACL__SERVICES__AUTH_SERVICE__SECRET=super-long-random-secret-for-auth-service-hmac-64-bytes
ACL__SERVICES__IDENTITY_SERVICE__SECRET=super-long-random-secret-for-identity-service-hmac-64-bytes
ACL__SERVICES__CITIZEN_DOCS_SERVICE__SECRET=super-long-random-secret-for-docs-service-hmac-64-bytes
ACL__SERVICES__MESSAGING_SERVICE__SECRET=super-long-random-secret-for-messaging-service-hmac-64-bytes

# ==============================================================================
# HTTP Server Configuration
# ==============================================================================
SERVER__HOST=0.0.0.0
SERVER__PORT=8080
SERVER__SHUTDOWN_TIMEOUT=1

# ==============================================================================
# Database Credentials (MongoDB)
# ==============================================================================
DATABASE__HOST=127.0.0.1
DATABASE__PORT=27017
DATABASE__NAME=kms_db
DATABASE__USER=kms_app_user
DATABASE__PASSWORD=your_secure_app_password
DATABASE__POOL_SIZE=10
DATABASE__AUTH_SOURCE=kms_db

# Root Credentials (MongoDB container init)
MONGO_ROOT_USER=admin_user
MONGO_ROOT_PASSWORD=your_secure_root_password

# ==============================================================================
# Cache & Public Keys Store (Redis)
# ==============================================================================
REDIS__ENABLED=false
REDIS__HOST=127.0.0.1
REDIS__PORT=6380
REDIS__PASSWORD=your_secure_redis_password
REDIS__DB=0

# ==============================================================================
# Rate Limiting Settings
# ==============================================================================
RATE_LIMIT__GLOBAL_PER_SECOND=100
RATE_LIMIT__GLOBAL_BURST=200
RATE_LIMIT__HEALTH_PER_SECOND=10
RATE_LIMIT__HEALTH_BURST=20
RATE_LIMIT__AUTH_PER_SECOND=5
RATE_LIMIT__AUTH_BURST=10