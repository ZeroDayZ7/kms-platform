{
  "services": {
    "auth-service": {
      "constraints": {
        "max_ttl_seconds": 86400,
        "default_ttl_seconds": 900
      },
      "redis": {
        "acl_rules": ["on", "+@read", "+ping", "~cache:auth:*"]
      }
    },
    "gateway-service": {
      "constraints": {
        "max_ttl_seconds": 7200,
        "default_ttl_seconds": 1800
      },
      "redis": {
        "acl_rules": ["on", "+@read", "+@write", "+ping", "~cache:gateway:*"]
      }
    }
  }
}
