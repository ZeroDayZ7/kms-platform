{
  "version": "2026-08-29",
  "statements": [
    {
      "sid": "AllowAuthServicePostgresCredentials",
      "effect": "Allow",
      "roles": ["auth-service"],
      "actions": ["kms:credentials:provision:postgres", "kms:credentials:read"],
      "resources": [
        "arn:kms:postgres:postgres_auth",
        "arn:kms:postgres:auth_database",
        "arn:kms:postgres:prod:db-auth"
      ]
    },
    {
      "sid": "AllowPostgresCredentialProvisioning",
      "effect": "Allow",
      "roles": ["provisioner-service", "db-automation-worker"],
      "actions": [
        "kms:credentials:provision",
        "kms:credentials:provision:postgres",
        "kms:credentials:read"
      ],
      "resources": [
        "arn:kms:postgres:db-auth",
        "arn:kms:postgres:prod/*",
        "arn:kms:postgres:staging/*"
      ]
    },
    {
      "sid": "AllowMinioCredentialProvisioning",
      "effect": "Allow",
      "roles": ["provisioner-service", "storage-automation-worker"],
      "actions": ["kms:credentials:provision:minio", "kms:credentials:read"],
      "resources": ["arn:kms:minio:prod/*", "arn:kms:minio:staging/*"]
    },
    {
      "sid": "AllowRabbitMQCredentialProvisioning",
      "effect": "Allow",
      "roles": ["provisioner-service", "event-bus-automation-worker"],
      "actions": ["kms:credentials:provision:rabbitmq", "kms:credentials:read"],
      "resources": ["arn:kms:rabbitmq:prod/*", "arn:kms:rabbitmq:staging/*"]
    },
    {
      "sid": "AllowCredentialRevocationAndRotation",
      "effect": "Allow",
      "roles": ["secops-admin", "kms-lifecycle-worker"],
      "actions": [
        "kms:credentials:revoke",
        "kms:credentials:rotate",
        "kms:credentials:read"
      ],
      "resources": ["arn:kms:*:*:*"]
    }
  ]
}
